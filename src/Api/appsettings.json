{
  "Application": {
    "Name": "MonolithObservabilityLab",
    "Environment": "Development",
    "PublicBaseUrl": "http://localhost:8080",
    "EnableSwagger": true
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5,
    "EnableSensitiveDataLogging": false,
    "PoolMinSize": 0,
    "PoolMaxSize": 100
  },
  "RateLimiting": {
    "Enabled": true,
    "Policy": "FixedWindow",
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6,
    "TokenLimit": 100,
    "TokensPerPeriod": 100,
    "ReplenishmentPeriodSeconds": 60,
    "QueueLimit": 0,
    "AutoReplenishment": true,
    "RejectionStatusCode": 429,
    "IncludeRetryAfterHeader": true,
    "PartitionBy": "ClientKey",
    "TrustedClientHeaderName": "X-Test-Client",
    "TestHeaderAllowedOnlyInDevelopment": true,
    "ConcurrencyPermitLimit": 100,
    "ExcludedPaths": [
      "/health/live",
      "/health/ready",
      "/metrics"
    ]
  },
  "RequestLimits": {
    "MaxBodySizeBytes": 1048576,
    "RequestTimeoutSeconds": 30
  },
  "TestEndpoints": {
    "Enabled": false,
    "AllowWrites": false,
    "MaxSyntheticWritesPerRun": 100000,
    "MaxRunDurationMinutes": 30,
    "RequireTestRunId": true
  },
  "Observability": {
    "ServiceName": "monolith-api",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "http://otel-collector:4317",
    "UseOtlpExporter": true,
    "EnableAspNetCoreInstrumentation": true,
    "EnableHttpClientInstrumentation": true,
    "EnableRuntimeInstrumentation": true,
    "EnableNpgsqlInstrumentation": true,
    "EnablePrometheusExporter": true,
    "PrometheusPath": "/metrics",
    "TraceSamplingRatio": 0.1,
    "CaptureExceptionDetails": true,
    "CaptureRequestBody": false,
    "CaptureResponseBody": false
  },
  "Logging": {
    "IncludeScopes": true,
    "IncludeFormattedMessage": true,
    "IncludeOriginalFormat": true,
    "MinimumLevel": "Information"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
