{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "EnableSensitiveDataLogging": true
  },
  "RateLimiting": {
    "Enabled": true,
    "Policy": "FixedWindow",
    "PermitLimit": 5,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "TestEndpoints": {
    "Enabled": true,
    "AllowWrites": true,
    "MaxSyntheticWritesPerRun": 50,
    "MaxRunDurationMinutes": 10,
    "RequireTestRunId": true
  },
  "Observability": {
    "UseOtlpExporter": false,
    "TraceSamplingRatio": 1.0
  }
}
