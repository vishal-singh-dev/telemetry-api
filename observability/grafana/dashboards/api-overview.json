  "panels": [
    {
      "title": "Requests Per Second (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[1m])) by (http_response_status_code)",
          "legendFormat": "Status {{http_response_status_code}}"
        }
      ]
    },
    {
      "title": "Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 (median)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Status Code Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(increase(http_server_request_duration_seconds_count[10m])) by (http_response_status_code)",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "title": "In-Flight HTTP Requests",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "http_server_in_flight_requests",
          "legendFormat": "In-flight"
        }
      ]
    },
    {
      "title": "Rate Limit Rejection Rate (429/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(rate_limit_rejected_total[1m]))",
          "legendFormat": "Rejections/sec"
        }
      ]
    },
    {
      "title": "Runtime Process CPU & Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "process_cpu_usage",
          "legendFormat": "Process CPU Usage"
        },
        {
          "expr": "dotnet_gc_heap_size_bytes",
          "legendFormat": "GC Heap Size (Bytes)"
        }
      ]
    }
