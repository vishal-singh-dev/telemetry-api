  "liveNow": false,
  "panels": [
    {
      "title": "Throughput: Requests / Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[1m]))",
          "legendFormat": "Total RPS"
        }
      ]
    },
    {
      "title": "Response Status Breakdown (2xx / 429 / 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"2..\"}[1m]))",
          "legendFormat": "2xx Success/s"
        },
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=\"429\"}[1m]))",
          "legendFormat": "429 Rate Limited/s"
        },
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx Server Error/s"
        }
      ]
    },
    {
      "title": "Total Completed Requests in Window",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(increase(http_server_request_duration_seconds_count[15m]))",
          "legendFormat": "Total Requests"
        }
      ]
    },
    {
      "title": "p95 and p99 Latency During Load Test",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency (s)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Latency (s)"
        }
      ]
    },
    {
      "title": "Synthetic Test Writes Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(synthetic_writes_total[1m]))",
          "legendFormat": "Synthetic Writes/s"
        },
        {
          "expr": "sum(rate(orders_created_total[1m]))",
          "legendFormat": "Orders Created/s"
        }
      ]
    }
  ],
  "refresh": "5s",
