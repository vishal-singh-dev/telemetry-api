{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "PostgreSQL Active vs Idle Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "legendFormat": "Active Connections"
        },
        {
          "expr": "pg_stat_activity_count{state=\"idle\"}",
          "legendFormat": "Idle Connections"
        }
      ]
    },
    {
      "title": "Connection Pool Saturation (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "(pg_stat_activity_count / 100) * 100",
          "legendFormat": "Pool Usage % (Max 100)"
        }
      ]
    },
    {
      "title": "PostgreSQL Transaction Commit / Rollback Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit[1m]))",
          "legendFormat": "Commits/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback[1m]))",
          "legendFormat": "Rollbacks/s"
        }
      ]
    },
    {
      "title": "Database Deadlocks and Conflicts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_deadlocks[1m]))",
          "legendFormat": "Deadlocks/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_conflicts[1m]))",
          "legendFormat": "Conflicts/s"
        }
      ]
    },
    {
      "title": "API Database Query Duration (Npgsql Spans / Commands)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_sum{http_route=~\"/api/.*\"}[1m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{http_route=~\"/api/.*\"}[1m])), 1)",
          "legendFormat": "Avg API DB-backed Endpoint Latency (s)"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["monolith", "postgres"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "Dashboard C: PostgreSQL",
  "uid": "monolith-postgresql"
}
