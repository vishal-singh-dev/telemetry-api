ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=observability_lab;Username=app_user;Password=local_dev_only_change_me
Database__PoolMaxSize=100
RateLimiting__Enabled=true
RateLimiting__Policy=FixedWindow
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60
RateLimiting__QueueLimit=0
RateLimiting__PartitionBy=ClientKey
TestEndpoints__Enabled=true
TestEndpoints__AllowWrites=false
Observability__OtlpEndpoint=http://otel-collector:4317
Observability__TraceSamplingRatio=0.1
